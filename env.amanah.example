
# ---- Amanah Auth API ----
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=60
# true = OTP ikut dikembalikan di respons (field debug_otp) untuk development/Postman. Diabaikan di production.
OTP_EXPOSE_IN_RESPONSE=true
RESET_TOKEN_TTL_MINUTES=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# WhatsApp: log (OTP ditulis ke storage/logs/laravel.log) atau http (gateway, mis. Fonnte)
WHATSAPP_DRIVER=log
WHATSAPP_API_URL=https://api.fonnte.com/send
WHATSAPP_API_TOKEN=
